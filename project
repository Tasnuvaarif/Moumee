        drawPerson(65, 570, 0.0f, 0.4f, 0.7f, false);
        drawPerson(95, 570, 0.1f, 0.7f, 0.9f, false);
        drawPerson(110, 570, 0.9f, 0.3f, 0.6f, true);
        drawPerson(125, 570, 0.3f, 0.8f, 1.0f, true);
        drawPerson(145, 570, 0.0f, 0.5f, 0.8f, false);

        drawPerson(340, 570, 0.9f, 0.5f, 0.0f, true);
        drawPerson(355, 570, 0.8f, 0.2f, 0.1f, true);
        drawPerson(370, 570, 0.0f, 0.4f, 0.8f, false);
        drawPerson(410, 570, 0.8f, 0.4f, 0.2f, true);
        drawPerson(425, 570, 1.0f, 0.6f, 0.0f, false);

        drawPerson(650, 570, 0.8f, 0.0f, 0.8f, true);
        drawPerson(665, 570, 0.2f, 0.2f, 0.9f, false);
        drawPerson(680, 570, 0.9f, 0.3f, 0.6f, true);
