void drawLineDDA(float x1, float y1, float x2, float y2) {
    float dx = x2 - x1;
    float dy = y2 - y1;
    float steps = max(abs(dx), abs(dy));
    float xInc = dx / steps;
    float yInc = dy / steps;
    float x = x1, y = y1;

    glBegin(GL_POINTS);
    for (int i = 0; i <= steps; i++) {
        glVertex2f(x, y);
        x += xInc;
        y += yInc;
    }
    glEnd();
}

void plotCirclePoints(int cx, int cy, int x, int y) {
    glBegin(GL_POINTS);
    glVertex2i(cx + x, cy + y); glVertex2i(cx - x, cy + y);
    glVertex2i(cx + x, cy - y); glVertex2i(cx - x, cy - y);
    glVertex2i(cx + y, cy + x); glVertex2i(cx - y, cy + x);
    glVertex2i(cx + y, cy - x); glVertex2i(cx - y, cy - x);
    glEnd();
}

void drawCircleMidpoint(int cx, int cy, int r) {
    int x = 0;
    int y = r;
    int p = 1 - r;
    plotCirclePoints(cx, cy, x, y);
    while (x < y) {
        x++;
        if (p < 0) {
            p += 2 * x + 1;
        } else {
            y--;
            p += 2 * (x - y) + 1;
        }
        plotCirclePoints(cx, cy, x, y);
    }
}


void drawRect(float x, float y, float w, float h, float r, float g, float b) {
    glColor3f(r, g, b);
    glBegin(GL_QUADS);
    glVertex2f(x, y); glVertex2f(x + w, y);
    glVertex2f(x + w, y + h); glVertex2f(x, y + h);
    glEnd();
}

void drawFilledCircle(float cx, float cy, float radius, float r, float g, float b) {
    glColor3f(r, g, b);
    glBegin(GL_POLYGON);
    for (int i = 0; i < 360; i += 10) {
        float theta = i * 3.14159f / 180.0f;
        glVertex2f(cx + radius * cos(theta), cy + radius * sin(theta));
    }
    glEnd();
}

void drawText(string text, float x, float y) {
    glColor3f(0, 0, 0);
    glRasterPos2f(x, y);
    for (char c : text) {
        glutBitmapCharacter(GLUT_BITMAP_HELVETICA_12, c);
    }
}

void drawWheel(float cx, float cy, float radius, float angle) {
    drawFilledCircle(cx, cy, radius, 0.1f, 0.1f, 0.1f);
    drawFilledCircle(cx, cy, radius * 0.6f, 0.8f, 0.8f, 0.8f);

    glPushMatrix();
    glTranslatef(cx, cy, 0);
    glRotatef(angle, 0, 0, 1);

    glColor3f(0.2f, 0.2f, 0.2f);
    glBegin(GL_LINES);
    glVertex2f(-radius * 0.6f, 0); glVertex2f(radius * 0.6f, 0);
    glVertex2f(0, -radius * 0.6f); glVertex2f(0, radius * 0.6f);
    glEnd();

    glPopMatrix();
}

void drawPerson(float x, float y, float bodyR, float bodyG, float bodyB, bool isFemale) {
    drawFilledCircle(x, y + 30, 8, 0, 0, 0);

    glColor3f(bodyR, bodyG, bodyB);
    glBegin(GL_TRIANGLES);
    if (isFemale) {
        glVertex2f(x, y + 25); glVertex2f(x - 15, y - 10); glVertex2f(x + 15, y - 10);
    } else {
        glVertex2f(x, y - 10); glVertex2f(x - 15, y + 25); glVertex2f(x + 15, y + 25);
    }
    glEnd();

    glColor3f(0, 0, 0);
    glBegin(GL_LINE_LOOP);
    if (isFemale) {
        glVertex2f(x, y + 25); glVertex2f(x - 15, y - 10); glVertex2f(x + 15, y - 10);
    } else {
        glVertex2f(x, y - 10); glVertex2f(x - 15, y + 25); glVertex2f(x + 15, y + 25);
    }
    glEnd();

    glColor3f(0, 0, 0);
    drawLineDDA(x - 5, y - 10, x - 10, y - 25);
    drawLineDDA(x + 5, y - 10, x + 10, y - 25);


    if (isFemale) {
        drawLineDDA(x - 5, y + 15, x - 18, y + 5);
        drawLineDDA(x + 5, y + 15, x + 18, y + 5);
    } else {
        drawLineDDA(x - 15, y + 25, x - 22, y + 5);
        drawLineDDA(x + 15, y + 25, x + 22, y + 5);
    }
}

void drawSeatedPerson(float x, float y, float r, float g, float b) {
    drawFilledCircle(x, y + 15, 8, 0, 0, 0);

    glColor3f(r, g, b);
    glBegin(GL_TRIANGLES);
    glVertex2f(x, y + 10);
    glVertex2f(x - 12, y);
    glVertex2f(x + 12, y);
    glEnd();

    glColor3f(0, 0, 0);
    glBegin(GL_LINE_LOOP);
    glVertex2f(x, y + 10); glVertex2f(x - 12, y); glVertex2f(x + 12, y);
    glEnd();

    drawLineDDA(x - 6, y + 5, x - 15, y - 2);
    drawLineDDA(x + 6, y + 5, x + 15, y - 2);
}

void drawFence(float startX, float endX, float baseY, float height) {
    glColor3f(0.9f, 0.9f, 0.9f);
    drawLineDDA(startX, baseY + height * 0.3f, endX, baseY + height * 0.3f);
    drawLineDDA(startX, baseY + height * 0.7f, endX, baseY + height * 0.7f);
    for(float x = startX; x <= endX; x += 20) {
        drawLineDDA(x, baseY, x, baseY + height);
    }
}

void drawSkyAndSun() {
    if (isDay) drawRect(0, 500, 1000, 500, 0.1f, 0.6f, 0.9f);
    else drawRect(0, 500, 1000, 500, 0.05f, 0.05f, 0.2f);


    if (isDay) {
        drawFilledCircle(150, 930, 40, 1.0f, 1.0f, 0.0f);
        glColor3f(1.0f, 0.5f, 0.0f);
        drawCircleMidpoint(150, 930, 42);
    } else {
        drawFilledCircle(150, 930, 35, 0.9f, 0.9f, 0.9f);
        glColor3f(1.0f, 1.0f, 1.0f);
        drawCircleMidpoint(150, 930, 37);
    }
}

void drawClouds() {
    glPushMatrix();
    glTranslatef(cloudOffset, 0, 0);
    float cloudColor = isDay ? 1.0f : 0.4f;
    float cloudSets[3][2] = {{150, 900}, {450, 920}, {750, 880}};

    for (int i = 0; i < 3; i++) {
        drawFilledCircle(cloudSets[i][0], cloudSets[i][1], 35, cloudColor, cloudColor, cloudColor);
        drawFilledCircle(cloudSets[i][0] - 30, cloudSets[i][1] - 10, 25, cloudColor, cloudColor, cloudColor);
        drawFilledCircle(cloudSets[i][0] + 30, cloudSets[i][1] - 10, 25, cloudColor, cloudColor, cloudColor);
    }
    glPopMatrix();
}

void drawMountains() {
    float peakColor = isDay ? 0.2f : 0.1f;

    float mountains[8][3] = {
        {-50, 250, 850},
        {100, 300, 960},
        {300, 200, 800},
        {400, 350, 920},
        {650, 220, 870},
        {750, 300, 980},
        {900, 150, 780},
        {980, 200, 890}
    };

    for (int i = 0; i < 8; i++) {
        float startX = mountains[i][0];
        float width = mountains[i][1];
        float peakY = mountains[i][2];
        float peakX = startX + (width / 2.0f);

        glColor3f(0.1f, peakColor + 0.4f, 0.2f);
        glBegin(GL_TRIANGLES);
        glVertex2f(startX, 550);
        glVertex2f(peakX, peakY);
        glVertex2f(startX + width, 550);
        glEnd();

        glColor3f(0, 0, 0);
        drawLineDDA(startX, 550, peakX, peakY);
        drawLineDDA(peakX, peakY, startX + width, 550);
    }
}

void drawWindmills() {
    for (int i = 100; i < 1000; i += 220) {
        drawRect(i - 15, 550, 30, 270, 0.8f, 0.7f, 0.6f);
        glPushMatrix();
        glTranslatef(i, 820, 0);
        glRotatef(windmillAngle, 0, 0, 1);
        for (int j = 0; j < 4; j++) {
            float angle = j * (3.14159f / 2.0f);
            glColor3f(0.9f, 0.9f, 0.9f);
            glBegin(GL_TRIANGLES);
            glVertex2f(0, 0);
            glVertex2f(110 * cos(angle - 0.25f), 110 * sin(angle - 0.25f));
            glVertex2f(110 * cos(angle + 0.25f), 110 * sin(angle + 0.25f));
            glEnd();
            glColor3f(0.2f, 0.2f, 0.2f);
            drawLineDDA(0, 0, 110 * cos(angle - 0.25f), 110 * sin(angle - 0.25f));
            drawLineDDA(110 * cos(angle - 0.25f), 110 * sin(angle - 0.25f), 110 * cos(angle + 0.25f), 110 * sin(angle + 0.25f));
            drawLineDDA(110 * cos(angle + 0.25f), 110 * sin(angle + 0.25f), 0, 0);
        }
        glPopMatrix();
    }
}

