}

void drawTrafficLight() {

    drawRect(390, 550, 8, 90, 0.2f, 0.2f, 0.2f);

    drawRect(379, 630, 30, 80, 0.1f, 0.1f, 0.1f);

    float r = (trafficState == 2) ? 1.0f : 0.2f;
    float y = (trafficState == 1) ? 1.0f : 0.2f;
    float g = (trafficState == 0) ? 1.0f : 0.2f;

    drawFilledCircle(394, 690, 10, r, 0, 0);
    drawFilledCircle(394, 670, 10, y, y, 0);
    drawFilledCircle(394, 650, 10, 0, g, 0);

    if (!isDay) {
        glEnable(GL_BLEND);
        glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
        if (trafficState == 2) { glColor4f(1, 0, 0, 0.4f); drawCircleMidpoint(394, 690, 15); }
        if (trafficState == 1) { glColor4f(1, 1, 0, 0.4f); drawCircleMidpoint(394, 670, 15); }
        if (trafficState == 0) { glColor4f(0, 1, 0, 0.4f); drawCircleMidpoint(394, 650, 15); }
        glDisable(GL_BLEND);
    }
}

