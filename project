void drawRiverAndPark() {
    drawRect(0, 330, 1000, 90, 0.7f, 0.2f, 0.2f);
    glColor3f(0.0f, 0.0f, 0.0f);
    for(int y = 330; y <= 420; y += 15) drawLineDDA(0, y, 1000, y);
    int row = 0;
    for(int y = 330; y < 420; y += 15) {
        int startX = (row % 2 == 0) ? 0 : 20;
        for(int x = startX; x <= 1000; x += 40) drawLineDDA(x, y, x, y + 15);
        row++;
    }

    drawFence(0, 1000, 420, 25);
    float waterB = isDay ? 0.8f : 0.4f;
    drawRect(0, 180, 1000, 150, 0.2f, 0.2f, waterB);
    drawFence(0, 1000, 180, 25);

    glPushMatrix();
    glTranslatef(boatOffset, 0, 0);
    drawRect(460, 230, 80, 20, 0.1f, 0.1f, 0.1f);
    glBegin(GL_TRIANGLES);
    glVertex2f(460, 230); glVertex2f(460, 250); glVertex2f(440, 250);
    glVertex2f(540, 230); glVertex2f(540, 250); glVertex2f(560, 250);
    glEnd();
    drawRect(480, 250, 50, 20, 1.0f, 1.0f, 0.0f);
    drawFilledCircle(470, 260, 5, 0, 0, 0);
    drawLineDDA(470, 256, 450, 220);
    glPopMatrix();

    drawRect(0, 0, 1000, 180, 0.6f, 0.7f, 0.4f);
    glColor3f(0.3f, 0.4f, 0.2f);
    for(int i = -200; i < 1200; i += 30) {
        drawLineDDA(i, 0, i + 180, 180);
        drawLineDDA(i, 180, i + 180, 0);
    }

    float benchX[] = {150, 400, 650};
    for(int i=0; i<3; i++) {
        drawRect(benchX[i], 100, 100, 20, 0.6f, 0.4f, 0.2f);
        if (isDay) {
            drawSeatedPerson(benchX[i] + 30, 120, 0.1f, 0.4f, 0.7f);
            drawSeatedPerson(benchX[i] + 70, 120, 0.8f, 0.2f, 0.5f);
        }
        drawRect(benchX[i]+10, 80, 10, 20, 0.6f, 0.4f, 0.2f);
        drawRect(benchX[i]+80, 80, 10, 20, 0.6f, 0.4f, 0.2f);
    }

    if (isDay) {
        drawPerson(550, 120, 0.7f, 0.7f, 0.7f, true);
        drawPerson(600, 50, 0.6f, 0.0f, 0.6f, false);
    }

    glColor3f(0.5f, 0.1f, 0.1f);
    glBegin(GL_POLYGON);
    glVertex2f(830, 50); glVertex2f(880, 50);
    glVertex2f(860, 300); glVertex2f(840, 300);
    glEnd();
    float treeG = isDay ? 0.8f : 0.4f;
    float leafCenters[6][2] = {{850, 450}, {750, 350}, {950, 350}, {800, 280}, {900, 280}, {850, 500}};
    for(int i=0; i<6; i++) drawFilledCircle(leafCenters[i][0], leafCenters[i][1], 90, 0.0f, treeG, 0.0f);
}


void display() {
    glClear(GL_COLOR_BUFFER_BIT);

    drawSkyAndSun();
    drawClouds();
    drawMountains();
    drawWindmills();
    drawBuildings();
    drawRoadAndVehicles();
    drawRiverAndPark();

    glFlush();
}

void timer(int) {
    cloudOffset += 0.5f;
    if (cloudOffset > 1000) cloudOffset = -1000;
    windmillAngle -= 2.0f;
    boatOffset -= 1.0f;
    if (boatOffset < -600) boatOffset = 600;


    lightTimer++;
    if (trafficState == 0 && lightTimer > 300) { trafficState = 1; lightTimer = 0; }
    else if (trafficState == 1 && lightTimer > 100) { trafficState = 2; lightTimer = 0; }
    else if (trafficState == 2 && lightTimer > 300) { trafficState = 0; lightTimer = 0; }

    float carFront = 450 + carOffset;
    if ((trafficState == 2 || trafficState == 1) && carFront > 410 && carFront < 435) {
        carSpeed = 0.0f;
    } else {
        carSpeed = 3.0f;
    }
    carOffset -= carSpeed;
    if (carSpeed > 0) wheelAngleCar += 7.5f;
    if (carOffset < -600) carOffset = 600;

    float busFront = 290 + busOffset;
    if ((trafficState == 2 || trafficState == 1) && busFront < 390 && busFront > 365) {
        busSpeed = 0.0f;
    } else {
        busSpeed = 2.0f;
    }
    busOffset += busSpeed;
    if (busSpeed > 0) wheelAngleBus -= 5.0f;
    if (busOffset > 1000) busOffset = -400;

    glutPostRedisplay();
    glutTimerFunc(1000 / 60, timer, 0);
}

void keyboard(unsigned char key, int x, int y) {
    if (key == 'd' || key == 'D') isDay = true;
    if (key == 'n' || key == 'N') isDay = false;
    glutPostRedisplay();
}

int main(int argc, char** argv) {
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(800, 800);
    glutCreateWindow("Project: Animated Cityscape with Traffic Logic");

    gluOrtho2D(0.0, 1000.0, 0.0, 1000.0);

    glutDisplayFunc(display);
    glutKeyboardFunc(keyboard);
    glutTimerFunc(0, timer, 0);

    cout << "--- Project Controls ---" << endl;
    cout << "Press 'D' for Day Mode" << endl;
    cout << "Press 'N' for Night Mode" << endl;

    glutMainLoop();
    return 0;
}
