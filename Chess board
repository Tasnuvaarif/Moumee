#include <GL/glut.h>

void display()
{
    glClear(GL_COLOR_BUFFER_BIT);


    glBegin(GL_QUADS);
    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(-2.0f,-02.0f);
    glVertex2f(-1.0f,-02.0f);
    glVertex2f(-1.0f,-01.0f);
    glVertex2f(-2.0f,-01.0f);

    glColor3f(1.0, 1.0, 1.0);
    glVertex2f(-1.0f,-02.0f);
    glVertex2f(0.0f,-02.0f);
    glVertex2f(0.0f,-01.0f);
    glVertex2f(-1.0f,-01.0f);

    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(-1.0f,-01.0f);
    glVertex2f(-0.0f,-01.0f);
    glVertex2f(0.0f,0.0f);
    glVertex2f(-1.0f,0.0f);

    glColor3f(1.0, 1.0, 1.0);
    glVertex2f(-1.0f,-01.0f);
    glVertex2f(-1.0f,0.0f);
    glVertex2f(-2.0f,0.0f);
    glVertex2f(-2.0f,-01.0f);

    glColor3f(1.0, 01.0, 01.0);
    glVertex2f(2.0f,-02.0f);
    glVertex2f(1.0f,-02.0f);
    glVertex2f(1.0f,-01.0f);
    glVertex2f(2.0f,-01.0f);

    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(1.0f,-02.0f);
    glVertex2f(0.0f,-02.0f);
    glVertex2f(0.0f,-01.0f);
    glVertex2f(1.0f,-01.0f);

    glColor3f(01.0, 01.0, 01.0);
    glVertex2f(1.0f,-01.0f);
    glVertex2f(0.0f,-01.0f);
    glVertex2f(0.0f,0.0f);
    glVertex2f(1.0f,0.0f);

    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(1.0f,-01.0f);
    glVertex2f(1.0f,0.0f);
    glVertex2f(2.0f,0.0f);
    glVertex2f(2.0f,-01.0f);



    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(2.0f,02.0f);
    glVertex2f(1.0f,02.0f);
    glVertex2f(1.0f,01.0f);
    glVertex2f(2.0f,01.0f);

    glColor3f(01.0, 01.0, 01.0);
    glVertex2f(1.0f,02.0f);
    glVertex2f(0.0f,02.0f);
    glVertex2f(0.0f,01.0f);
    glVertex2f(1.0f,01.0f);

    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(1.0f,01.0f);
    glVertex2f(0.0f,01.0f);
    glVertex2f(0.0f,0.0f);
    glVertex2f(1.0f,0.0f);

    glColor3f(01.0, 01.0, 01.0);
    glVertex2f(1.0f,01.0f);
    glVertex2f(1.0f,0.0f);
    glVertex2f(2.0f,0.0f);
    glVertex2f(2.0f,01.0f);



    glColor3f(01.0, 01.0, 01.0);
    glVertex2f(-2.0f,02.0f);
    glVertex2f(-1.0f,02.0f);
    glVertex2f(-1.0f,01.0f);
    glVertex2f(-2.0f,01.0f);

    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(-1.0f,02.0f);
    glVertex2f(-0.0f,02.0f);
    glVertex2f(-0.0f,01.0f);
    glVertex2f(-1.0f,01.0f);

    glColor3f(01.0, 01.0, 01.0);
    glVertex2f(-1.0f,01.0f);
    glVertex2f(-0.0f,01.0f);
    glVertex2f(-0.0f,0.0f);
    glVertex2f(-1.0f,0.0f);

    glColor3f(0.0, 0.0, 0.0);
    glVertex2f(-1.0f,01.0f);
    glVertex2f(-1.0f,0.0f);
    glVertex2f(-2.0f,0.0f);
    glVertex2f(-2.0f,01.0f);
    glEnd();
    glFlush();
}

void init()
{
    glClearColor(1.0, 0.7, 0.60, 1.0);
    glColor3f(0.0, 0.0, 0.0);
    glPointSize(4.0);
    glMatrixMode(GL_PROJECTION);
    glLoadIdentity();
    gluOrtho2D(-5, 5, -5, 5);
}

int main(int argc, char** argv)
{
    glutInit(&argc, argv);
    glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
    glutInitWindowSize(500, 500);

    glutInitWindowPosition(100, 100);
    glutCreateWindow("Drawing Points");
    init();
    glutDisplayFunc(display);
    glutMainLoop();
    return 0;
}
