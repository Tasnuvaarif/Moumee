from flask import Flask, render_template_string
import subprocess
from datetime import datetime
import time
from urllib.parse import urlparse # URL ক্লিন করার লাইব্রেরি

app = Flask(__name__)

start_time = time.time()

def get_uptime():
    seconds = int(time.time() - start_time)
    m, s = divmod(seconds, 60)
    h, m = divmod(m, 60)
    return f"{h}h {m}m {s}s"

# --- URL থেকে শুধু নাম বের করার ফাংশন ---
def get_clean_domain(url):
    try:
        # যদি URL 'http' দিয়ে শুরু হয়
        if url.startswith('http'):
            parsed = urlparse(url)
            domain = parsed.netloc
            # পোর্ট নম্বর থাকলে ফেলে দাও (যেমন :443)
            return domain.split(':')[0]
        # যদি সরাসরি ডোমেইন হয় (CONNECT request)
        else:
            return url.split(':')[0]
    except:
        return url

# --- Log Analysis ---
def analyze_logs():
    log_file = "/var/log/squid/access.log"
    
    total = 0
    blocked = 0
    cached = 0
    normal = 0
    
    blocked_list = []
    cached_list = []

    try:
        with open(log_file, "r") as file:
            lines = file.readlines()
            total = len(lines)
            
            for line in reversed(lines):
                try:
                    parts = line.split()
                    if len(parts) < 7: continue

                    timestamp = float(parts[0])
                    time_str = datetime.fromtimestamp(timestamp).strftime('%H:%M:%S')
                    client_ip = parts[2]
                    raw_url = parts[6]

                    # URL ক্লিন করা হচ্ছে
                    if raw_url == '-': 
                        clean_url = "Direct/Hidden"
                    else:
                        clean_url = get_clean_domain(raw_url)

                    # ব্লকিং চেক
                    if "TCP_DENIED" in line:
                        blocked += 1
                        if len(blocked_list) < 10:
                            blocked_list.append({
                                'time': time_str,
                                'ip': client_ip,
                                'url': clean_url # ক্লিন নাম যাবে
                            })

                    # ক্যাশিং চেক
                    elif "TCP_HIT" in line or "TCP_MEM_HIT" in line:
                        cached += 1
                        if len(cached_list) < 10:
                            cached_list.append({
                                'time': time_str,
                                'ip': client_ip,
                                'url': clean_url # ক্লিন নাম যাবে
                            })
                    
                    else:
                        normal += 1
                        
                except:
                    continue
        
        normal = total - blocked - cached
        if normal < 0: normal = 0

    except Exception as e:
        return 0, 0, 0, 0, [], [], "Offline"

    return total, blocked, cached, normal, blocked_list, cached_list

